# Variabel Lingkungan (Environment Variables) - IN DENTAL CARE Backend

# ============================================================
# KONFIGURASI DATABASE POSTGRESQL
# ============================================================
# Ganti YOUR_PASSWORD dengan password PostgreSQL Anda
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/indentalcare_db?schema=public"

# ============================================================
# KONFIGURASI SERVER
# ============================================================
PORT=5000
NODE_ENV=development

# ============================================================
# KONFIGURASI JWT (JSON Web Token)
# ============================================================
# Ganti dengan string acak dan rahasia minimal 32 karakter
JWT_SECRET=ganti_dengan_secret_key_rahasia_anda_disini
JWT_EXPIRES_IN=1h

# ============================================================
# KONFIGURASI CORS
# ============================================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

